{
  "name": "isbar-companero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "paquete:registrar": "powershell -ExecutionPolicy Bypass -File scripts/register-dev.ps1",
    "paquete:quitar": "powershell -ExecutionPolicy Bypass -File scripts/unregister-dev.ps1",
    "paquete:comprobar": "powershell -ExecutionPolicy Bypass -File scripts/check-identity.ps1",
    "claude:instalar": "node scripts/claude-statusline/instalar.mjs",
    "claude:quitar": "node scripts/claude-statusline/desinstalar.mjs",
    "paquete:store": "powershell -ExecutionPolicy Bypass -File scripts/paquete-store.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "license": "MIT"
}
